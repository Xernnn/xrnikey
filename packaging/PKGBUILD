# Builds the Fcitx5 input method from the git checkout this file is in: its
# committed HEAD, not uncommitted changes. From packaging/:
#   makepkg -si          build, test and install (asks for sudo)
#   makepkg              build and test only; install later with pacman -U
pkgname=xrnikey
pkgver=1.0.0
pkgrel=1
pkgdesc="Vietnamese (Telex/VNI) input method for Fcitx5"
arch=('x86_64' 'aarch64')
url="https://github.com/Xernnn/xrnikey"
license=('MIT')
depends=('fcitx5' 'gcc-libs' 'glibc')
makedepends=('catch2' 'cmake' 'extra-cmake-modules' 'git' 'ninja')
# For the test that runs fcitx5 over D-Bus; it is skipped without them.
checkdepends=('dbus' 'python-gobject')
optdepends=('fcitx5-configtool: settings window'
            'python: the xk-dict and xk-macro tools'
            'fcitx5-gtk: GTK apps under X11/XWayland'
            'fcitx5-qt: Qt apps')
source=("$pkgname::git+file://${startdir%/packaging}")
sha256sums=('SKIP')

build() {
    # The IBus engine is not built: it targets the long-gone python-ibus API.
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_REQUIRE_FIND_PACKAGE_Fcitx5Core=ON \
        -DXRNIKEY_BUILD_IBUS=OFF \
        -DXRNIKEY_ENABLE_TESTS=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
