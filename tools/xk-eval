#!/usr/bin/env python3
"""xk-eval: measure the engine against the targets in android/docs/feature-spec.md.

usage: xk-eval --lib LIBXRNIKEY --vi VI.xklm [--en EN.xklm] [--work WORK]
               [--chat data/lm/eval/chat.txt] [--json OUT] [--quick]

Sets (feature-spec.md, "Done means"):
  H1    held-out news and web sentences   WORK/H1.txt   (data/lm/build.py prepare)
  H2    held-out short sentences          WORK/H2.txt
  C     made-up chat messages             data/lm/eval/chat.txt
  E     common English words              core/data/english.txt
  V     attested Vietnamese syllables     core/data/vi-syllables.txt

Every number is printed whether or not it reaches its target. --quick
samples the sets (for CI, where the models are the small test ones and the
numbers mean nothing beyond "it runs").
"""

import argparse
import ctypes
import hashlib
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "data", "lm"))
import xklm_text  # noqa: E402


class Lm:
    def __init__(self, lib, path):
        L = lib
        L.xk_lm_open.restype = ctypes.c_void_p
        L.xk_lm_open.argtypes = [ctypes.c_char_p]
        L.xk_lm_vocab_size.argtypes = [ctypes.c_void_p]
        L.xk_lm_word.restype = ctypes.c_char_p
        L.xk_lm_word.argtypes = [ctypes.c_void_p, ctypes.c_int]
        L.xk_lm_logprob.restype = ctypes.c_float
        L.xk_lm_logprob.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_char_p), ctypes.c_int,
                                    ctypes.c_char_p]
        self.L = L
        self.path = path
        self.ptr = L.xk_lm_open(path.encode())
        if not self.ptr:
            sys.exit(f"xk-eval: cannot open model {path}")
        self._uni = {}

    def words(self):
        for i in range(self.L.xk_lm_vocab_size(self.ptr)):
            yield self.L.xk_lm_word(self.ptr, i).decode()

    def logprob(self, ctx, word):
        arr = (ctypes.c_char_p * max(len(ctx), 1))(*[c.encode() for c in ctx])
        return self.L.xk_lm_logprob(self.ptr, arr, len(ctx), word.encode())

    def unigram(self, word):
        if word not in self._uni:
            self._uni[word] = self.logprob([], word)
        return self._uni[word]


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()[:12]


def read_lines(path):
    with open(path, encoding="utf-8") as f:
        return [line.rstrip("\n") for line in f if line.strip() and not line.startswith("#")]


# ---- what is typed ----------------------------------------------------------

def chat_items(engine, path):
    """Set C as (intended token, is Vietnamese) lists, one per message. A
    token is English (or an abbreviation) when it is not a syllable, or when
    the message wrote it in [brackets]."""
    messages = []
    for line in read_lines(path):
        bracketed = set()
        text = []
        for part in line.replace("[", " [").replace("]", "] ").split():
            if part.startswith("[") and part.endswith("]"):
                bracketed.add(part[1:-1].lower())
                text.append(part[1:-1])
            else:
                text.append(part)
        for sent in xklm_text.sentences(engine, " ".join(text)):
            items = []
            for tok in sent:
                if tok.startswith("<"):
                    items.append((tok, None))
                else:
                    vi = engine.syllable(tok) is not None and tok not in bracketed
                    items.append((tok, vi))
            messages.append(items)
    return messages


def sentence_items(engine, path):
    out = []
    for line in read_lines(path):
        items = []
        for tok in line.split():
            if tok.startswith("<"):
                items.append((tok, None))
            else:
                items.append((tok, engine.syllable(tok) is not None))
        out.append(items)
    return out


# ---- restoration -------------------------------------------------------------

class Shapes:
    """ASCII shape -> the syllables it may stand for (the model's and the
    attested list's)."""

    def __init__(self, engine, lm, syllable_file):
        self.by_shape = {}
        words = set(w for w in lm.words() if not w.startswith("<"))
        words.update(read_lines(syllable_file))
        for w in words:
            if engine.syllable(w) == w:
                self.by_shape.setdefault(xklm_text.strip_marks(w), []).append(w)

    def candidates(self, typed):
        return self.by_shape.get(typed, [])


class Candidate(ctypes.Structure):
    _fields_ = [("text", ctypes.c_char * 128), ("score", ctypes.c_float),
                ("edit_distance", ctypes.c_int), ("type", ctypes.c_int)]


class Restorer:
    """The engine's accent restoration (xk_restore_word, xk_restore_run)."""

    def __init__(self, lib, models):
        lm = models
        L = lib
        L.xk_restore_word.restype = ctypes.c_int
        L.xk_restore_word.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_char_p), ctypes.c_int,
                                      ctypes.c_char_p, ctypes.POINTER(Candidate), ctypes.c_int]
        L.xk_restore_run.restype = ctypes.c_int
        L.xk_restore_run.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_char_p), ctypes.c_int,
                                     ctypes.POINTER(ctypes.c_char_p), ctypes.c_int, ctypes.c_char_p,
                                     ctypes.POINTER(ctypes.c_void_p)]
        self.L, self.lm = L, lm
        self.libc = ctypes.CDLL(None)
        self.libc.free.argtypes = [ctypes.c_void_p]

    @staticmethod
    def _ctx(ctx):
        ctx = ctx[-3:]
        return (ctypes.c_char_p * max(len(ctx), 1))(*[c.encode() for c in ctx]), len(ctx)

    def word(self, ctx, typed, k=1):
        arr, n = self._ctx(ctx)
        out = (Candidate * k)()
        got = self.L.xk_restore_word(self.lm, arr, n, typed.encode(), out, k)
        return [out[i].text.decode() for i in range(got)] or [typed]

    def run(self, ctx, typed, nxt=None):
        arr, n = self._ctx(ctx)
        words = (ctypes.c_char_p * len(typed))(*[t.encode() for t in typed])
        out = (ctypes.c_void_p * len(typed))()
        got = self.L.xk_restore_run(self.lm, arr, n, words, len(typed),
                                    nxt.encode() if nxt else None, out)
        if got != len(typed):
            return list(typed)
        res = []
        for i in range(got):
            res.append(ctypes.string_at(out[i]).decode())
            self.libc.free(out[i])
        return res


def eval_lookback(sentences, restorer, back=2):
    """Top-1 when each word, as it is typed, may also change the `back`
    words before it (the keyboard's look-back): the run of typed words since
    the last number or pause, at most back+1 long, is decoded again whole.
    A pause (",") or the end of the sentence decodes the run once more,
    knowing what follows it, as the keyboard does when that key is typed."""
    right = total = exact = 0
    for items in sentences:
        out, typed, run_start = ["<s>"], [None], 1

        def close(nxt):
            frm = max(run_start, len(out) - 1 - back)
            if frm < len(out) and all(t is not None for t in typed[frm:]):
                out[frm:] = restorer.run(out[:frm], typed[frm:], nxt)

        for tok, vi in items:
            if vi is None:
                if tok == "<p>":
                    close("<p>")
                out.append(tok)
                typed.append(None)
                run_start = len(out)
                continue
            out.append(None)
            typed.append(xklm_text.strip_marks(tok) if vi else tok)
            frm = max(run_start, len(out) - 1 - back)
            out[frm:] = restorer.run(out[:frm], typed[frm:])
        close("</s>")
        ok = True
        for (tok, vi), got in zip(items, out[1:]):
            if vi:
                total += 1
                if got == tok:
                    right += 1
                else:
                    ok = False
        exact += ok
    return right, total, exact, len(sentences)


def decode(items, typed, restorer, back=2):
    """What the keyboard ends with for one sentence typed as `typed` (one
    entry per item; None for numbers and pauses), with look-back as in
    eval_lookback."""
    out, run_start = ["<s>"], 1
    typed = [None] + list(typed)

    def close(nxt):
        frm = max(run_start, len(out) - 1 - back)
        if frm < len(out) and all(t is not None for t in typed[frm:len(out)]):
            out[frm:] = restorer.run(out[:frm], typed[frm:len(out)], nxt)

    for k, (tok, vi) in enumerate(items):
        if vi is None:
            if tok == "<p>":
                close("<p>")
            out.append(tok)
            run_start = len(out)
            continue
        out.append(None)
        frm = max(run_start, len(out) - 1 - back)
        out[frm:] = restorer.run(out[:frm], typed[frm:len(out)])
    close("</s>")
    return out[1:]


# The phone's QWERTY rows in key widths, as in core/keys.cpp.
KEY_POS = {}
for _r, (_row, _x0) in enumerate((("qwertyuiop", 0.0), ("asdfghjkl", 0.5), ("zxcvbnm", 1.5))):
    for _i, _c in enumerate(_row):
        KEY_POS[_c] = (_x0 + _i, float(_r))


def neighbours(c):
    """The keys within 1.5 key widths of `c`, weighted as keys.cpp does."""
    import math
    x, y = KEY_POS[c]
    out = []
    for k, (kx, ky) in KEY_POS.items():
        d = math.hypot(kx - x, ky - y)
        if k != c and d <= 1.5:
            out.append((k, math.exp(-d * d / (2 * 0.6 * 0.6))))
    return out


def corrupt(word, rng, rate):
    """Each letter, with probability `rate`, typed as a neighbouring key."""
    out = []
    for c in word:
        if c in KEY_POS and rng.random() < rate:
            keys, weights = zip(*neighbours(c))
            c = rng.choices(keys, weights)[0]
        out.append(c)
    return "".join(out)


def eval_typos(sentences, restorer, set_level, seed, rate=0.03):
    """Typos at `rate` per letter, deterministic for `seed`, in sentences
    typed without marks. Returns (fixed, mistyped, right, changed, clean):
    mistyped words that come out as their clean typing does, mistyped words
    that come out as meant, and clean words that correction changes."""
    import random
    rng = random.Random(seed)
    fixed = mistyped = right = changed = clean = 0
    for items in sentences:
        typed = [None if vi is None else (xklm_text.strip_marks(tok) if vi else tok) for tok, vi in items]
        bad = [None if t is None else corrupt(t, rng, rate) for t in typed]
        set_level(0)
        off = decode(items, typed, restorer)
        set_level(1)
        on = decode(items, typed, restorer)
        if bad == typed:
            got = on
        else:
            got = decode(items, bad, restorer)
        for (tok, vi), t, b, o_off, o_on, g in zip(items, typed, bad, off, on, got):
            if t is None:
                continue
            clean += 1
            changed += o_on != o_off
            if b != t:
                mistyped += 1
                fixed += g == o_on
                right += g == tok
    set_level(0)
    return fixed, mistyped, right, changed, clean


def eval_topk(sentences, restorer, k=3):
    """How often the intended syllable is among the first k candidates, the
    words before it typed right (what the strip would offer)."""
    hit = total = 0
    for items in sentences:
        ctx = ["<s>"]
        for tok, vi in items:
            if vi:
                total += 1
                hit += tok in restorer.word(ctx, xklm_text.strip_marks(tok), k)
            ctx.append(tok)
    return hit, total


def restore_unigram(lm, shapes, typed):
    cands = shapes.candidates(typed)
    if not cands:
        return typed
    return max(cands, key=lambda c: (lm.unigram(c), c == typed))


def eval_restoration(sentences, restore):
    """Top-1 over the Vietnamese syllables of `sentences`, each typed without
    marks. `restore(context_tokens, typed)` gives the chosen token."""
    right = total = 0
    exact = 0
    for items in sentences:
        ctx = ["<s>"]
        ok_sentence = True
        for tok, vi in items:
            if vi is None:
                ctx.append(tok)
                continue
            typed = xklm_text.strip_marks(tok) if vi else tok
            got = restore(ctx, typed)
            if vi:
                total += 1
                if got == tok:
                    right += 1
                else:
                    ok_sentence = False
            ctx.append(got)
        exact += ok_sentence
    return right, total, exact, len(sentences)


# ---- Telex through the engine -------------------------------------------------

MODELS = []  # the XKModels bundle for xk_state_set_models, when both models are given


def type_words(engine, words):
    """Type `words` with Telex, each followed by Space, into one fresh state
    (with the language models, when given); return what each word was
    committed as."""
    lib = engine.lib
    s = lib.xk_state_new(0)
    if MODELS:
        lib.xk_state_set_models(s, MODELS[0])
    out = []
    try:
        for keys in words:
            for c in keys:
                lib.xk_process_key(s, ord(c), 0)
            r = lib.xk_process_key(s, 0x20, 0)
            out.append(r.commit.decode("utf-8", "replace").rstrip(" "))
    finally:
        lib.xk_state_free(s)
    return out


def eval_english(engine, words, before=None):
    """English words typed with Telex: how many come out as typed. `before`
    is typed first, as context."""
    kept = []
    for w in words:
        seq = ([before] if before else []) + [w]
        got = type_words(engine, seq)[-1]
        kept.append(got == w)
    return sum(kept), len(kept), [w for w, k in zip(words, kept) if not k]


def eval_english_in_context(engine, messages):
    """Set C typed with Telex, message by message (the Vietnamese as Telex
    keys, English as it is): how many English words and abbreviations come
    out as typed."""
    kept = total = 0
    missed = []
    for items in messages:
        words = [(tok, vi) for tok, vi in items if vi is not None]
        keys = [xklm_text.telex_keys(tok) if vi else tok for tok, vi in words]
        got = type_words(engine, keys)
        for (tok, vi), g in zip(words, got):
            if vi is False:
                total += 1
                if g == tok:
                    kept += 1
                else:
                    missed.append(f"{tok}->{g}")
    return kept, total, missed


def eval_english_restored(messages, restorer):
    """Set C typed without marks, with look-back: how many English words and
    abbreviations come out as typed."""
    kept = total = 0
    missed = []
    for items in messages:
        out, typed = ["<s>"], [None]
        for tok, vi in items:
            if vi is None:
                out.append(tok)
                typed.append(None)
                continue
            out.append(None)
            typed.append(xklm_text.strip_marks(tok) if vi else tok)
            frm = len(out) - 1
            while frm > 1 and typed[frm - 1] is not None and frm > len(out) - 3:
                frm -= 1
            out[frm:] = restorer.run(out[:frm], typed[frm:])
        for (tok, vi), g in zip(items, out[1:]):
            if vi is False:
                total += 1
                if g == tok:
                    kept += 1
                else:
                    missed.append(f"{tok}->{g}")
    return kept, total, missed


def eval_vietnamese(engine, syllables, before="tooi"):
    """Attested syllables typed with Telex after a Vietnamese word: how many
    come out as something else."""
    bad = []
    for syl in syllables:
        got = type_words(engine, [before, xklm_text.telex_keys(syl)])[-1]
        if got != syl:
            bad.append((syl, got))
    return len(bad), len(syllables), bad


NINETEEN = [
    # word, English context (typed first), Vietnamese context keys, Vietnamese result
    ("boost", "the", "ddooi", "bốt"), ("boots", "my", "ddooi", "bốt"),
    ("corn", "the", "chuyeenj", "cỏn"), ("cups", "two", "giafnh", "cúp"),
    ("hangs", "it", "ddau", "háng"), ("keeps", "she", "banhs", "kếp"),
    ("lifts", "it", "hai", "lít"), ("list", "my", "hai", "lít"),
    ("lips", "her", "booj", "líp"), ("lisp", "the", "booj", "líp"),
    ("lust", "the", "ngaapj", "lút"), ("photos", "my", "dinhs", "phốt"),
    ("row", "the", "bij", "rơ"), ("runs", "he", "loox", "rún"),
    ("sits", "she", "raats", "sít"), ("tips", "the", "ddungs", "típ"),
    ("turn", "your", "ngawns", "tủn"), ("verse", "the", "hai", "vế"),
    ("virus", "the", "nius", "víu"),
]


def unambiguous_keys(syllable, english):
    """Telex keys for a syllable that do not spell an English word: the
    usual order ("tủn" -> "tunr"), or the tone key right after the first
    vowel when that order is English ("bốt": "boots" -> "bosot")."""
    keys = xklm_text.telex_keys(syllable)
    if keys not in english:
        return keys
    body, tone = keys[:-1], keys[-1]
    for i, c in enumerate(body):
        if c in "aeiouy":
            alt = body[:i + 1] + tone + body[i + 1:]
            if alt not in english:
                return alt
    return keys


def type_words_learning(engine, words):
    """type_words with XK_OPT_LEARN on."""
    lib = engine.lib
    s = lib.xk_state_new(0)
    lib.xk_state_set_models(s, MODELS[0])
    lib.xk_state_set_option(s, 5, 1)
    for keys in words:
        for c in keys:
            lib.xk_process_key(s, ord(c), 0)
        lib.xk_process_key(s, 0x20, 0)
    lib.xk_state_free(s)


def eval_nineteen(engine):
    rows = []
    for word, en_ctx, vi_ctx, vi_word in NINETEEN:
        en_got = type_words(engine, [en_ctx, word])[-1]
        vi_got = type_words(engine, [vi_ctx, word])[-1]
        rows.append((f"{en_ctx} {word}", word, en_got))
        rows.append((f"{vi_ctx} {word}", vi_word, vi_got))
    return rows


# ---- report -------------------------------------------------------------------

def pct(a, b):
    return 100.0 * a / b if b else float("nan")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--lib", required=True)
    ap.add_argument("--vi", required=True)
    ap.add_argument("--en")
    ap.add_argument("--work")
    ap.add_argument("--chat", default=os.path.join(ROOT, "data", "lm", "eval", "chat.txt"))
    ap.add_argument("--english", default=os.path.join(ROOT, "core", "data", "english.txt"))
    ap.add_argument("--syllables", default=os.path.join(ROOT, "core", "data", "vi-syllables.txt"))
    ap.add_argument("--json")
    ap.add_argument("--quick", action="store_true")
    args = ap.parse_args()

    engine = xklm_text.Engine(os.path.abspath(args.lib))
    vi = Lm(engine.lib, args.vi)
    en = Lm(engine.lib, args.en) if args.en else None
    L = engine.lib
    L.xk_models_new.restype = ctypes.c_void_p
    L.xk_models_new.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    L.xk_state_set_models.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
    # Restoration and the Telex choice score with the same bundle.
    models = L.xk_models_new(vi.ptr, en.ptr if en else None)
    if en:
        MODELS[:] = [models]
    shapes = Shapes(engine, vi, args.syllables)
    results = []

    def row(set_name, metric, value, target, higher=True, detail=""):
        met = None if target is None else (value >= target if higher else value <= target)
        results.append({"set": set_name, "metric": metric, "value": round(value, 2),
                        "target": target, "higher_is_better": higher, "met": met, "detail": detail})

    sets = {}
    if args.work:
        for name in ("H1", "H2"):
            path = os.path.join(args.work, f"{name}.txt")
            if os.path.exists(path):
                sets[name] = sentence_items(engine, path)
    dev = sentence_items(engine, os.path.join(args.work, "dev.txt"))[:500] if args.work and \
        os.path.exists(os.path.join(args.work, "dev.txt")) else None
    sets["C"] = chat_items(engine, args.chat)
    if args.quick:
        sets = {k: v[:100] for k, v in sets.items()}
    restoration_sets = dict(sets)
    if dev:
        sets["dev"] = dev[:100] if args.quick else dev

    targets = {"H1": 95.0, "H2": 94.0, "C": 93.0}
    restorer = Restorer(engine.lib, models)
    for name, sentences in restoration_sets.items():
        r, t, ex, n = eval_restoration(sentences, lambda ctx, typed: typed)
        row(name, "restoration top-1, baseline: left without marks", pct(r, t), None,
            detail=f"{r}/{t} syllables")
        r, t, ex, n = eval_restoration(sentences, lambda ctx, typed: restore_unigram(vi, shapes, typed))
        row(name, "restoration top-1, baseline: most frequent syllable", pct(r, t), None,
            detail=f"{r}/{t} syllables, {ex}/{n} sentences exact")
        r, t, ex, n = eval_restoration(sentences, lambda ctx, typed: restorer.word(ctx, typed)[0])
        row(name, "restoration top-1, word by word", pct(r, t), None,
            detail=f"{r}/{t} syllables, {ex}/{n} sentences exact")
        r, t, ex, n = eval_lookback(sentences, restorer)
        row(name, "restoration top-1, with look-back", pct(r, t), targets[name],
            detail=f"{r}/{t} syllables, {ex}/{n} sentences exact")
        if name == "H1":
            h, t = eval_topk(sentences, restorer)
            row(name, "restoration in the strip (top-3)", pct(h, t), 99.0, detail=f"{h}/{t} syllables")

    english = read_lines(args.english)
    syllables = read_lines(args.syllables)
    if args.quick:
        english, syllables = english[::50], syllables[::50]
    k, n, missed = eval_english(engine, english, before="the")
    row("E", "English typed with Telex after 'the', kept as typed", pct(k, n), 99.5,
        detail=f"{k}/{n}; e.g. {', '.join(missed[:12])}")
    bad, n, examples = eval_vietnamese(engine, syllables)
    row("V", "syllables typed with Telex after 'tôi', turned into something else", pct(bad, n), 0.5,
        higher=False, detail=f"{bad}/{n}; e.g. {', '.join(f'{a}->{b}' for a, b in examples[:8])}")

    k, n, missed = eval_english_in_context(engine, sets["C"])
    row("C", "English and abbreviations, the Vietnamese typed with Telex, kept as typed", pct(k, n), 98.0,
        detail=f"{k}/{n}; e.g. {', '.join(missed[:12])}")
    k, n, missed = eval_english_restored(sets["C"], restorer)
    row("C", "English and abbreviations, the Vietnamese typed without marks, kept as typed",
        pct(k, n), None, detail=f"{k}/{n}; e.g. {', '.join(missed[:12])}")

    L.xk_models_set_correction.argtypes = [ctypes.c_void_p, ctypes.c_int]
    set_level = lambda level: L.xk_models_set_correction(models, level)
    typo_sets = {"T": ("C", 2026)}
    if "dev" in sets:
        typo_sets["dev"] = ("dev", 7)
    for name, (base, seed) in typo_sets.items():
        f, m, r, ch, cl = eval_typos(sets[base], restorer, set_level, seed)
        row(name, "typos fixed: mistyped words that come out as their clean typing does", pct(f, m),
            85.0 if name == "T" else None, detail=f"{f}/{m} mistyped words; {r} come out as meant")
        row(name, "correct words changed by correction", pct(ch, cl), 1.0 if name == "T" else None,
            higher=False, detail=f"{ch}/{cl} words")

    english_set = set(read_lines(args.english))
    rows19 = eval_nineteen(engine)
    ok = sum(1 for _, want, got in rows19 if want == got)
    row("19", "the 19 words, right in both contexts", pct(ok, len(rows19)), 100.0,
        detail=f"{ok}/{len(rows19)} rows; wrong: " +
               ", ".join(f"{c} -> {g}" for c, w, g in rows19 if w != g))
    if MODELS:
        # The owner fixes each Vietnamese row that came out wrong by typing it
        # twice with keys that can only be Vietnamese, learning on; then every
        # row, English ones included, is typed again.
        L = engine.lib
        L.xk_user_new.restype = ctypes.c_void_p
        L.xk_models_set_user.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
        L.xk_user_free.argtypes = [ctypes.c_void_p]
        L.xk_state_set_option.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
        user = L.xk_user_new()
        L.xk_models_set_user(MODELS[0], user)
        fixed = []
        for word, en_ctx, vi_ctx, vi_word in NINETEEN:
            if type_words(engine, [vi_ctx, word])[-1] != vi_word:
                fixed.append(vi_word)
                for _ in range(2):
                    type_words_learning(engine, [vi_ctx, unambiguous_keys(vi_word, english_set)])
        rows_after = eval_nineteen(engine)
        ok = sum(1 for _, want, got in rows_after if want == got)
        row("19", "the 19 words, after the owner typed each wrong pair twice", pct(ok, len(rows_after)),
            100.0, detail=f"{ok}/{len(rows_after)} rows; learned: {', '.join(fixed) or '-'}; wrong: " +
                          ", ".join(f"{c} -> {g}" for c, w, g in rows_after if w != g))
        L.xk_models_set_user(MODELS[0], None)
        L.xk_user_free(user)

    print(f"xk-eval  lib {os.path.basename(args.lib)}  vi {os.path.basename(args.vi)} {sha(args.vi)}"
          + (f"  en {os.path.basename(args.en)} {sha(args.en)}" if args.en else ""))
    print(f"{'set':<4} {'result':>9} {'target':>9}  {'':5}  metric")
    for r in results:
        tgt = "" if r["target"] is None else ("≥ " if r["higher_is_better"] else "≤ ") + f"{r['target']:.1f}"
        mark = "" if r["met"] is None else ("ok" if r["met"] else "short")
        print(f"{r['set']:<4} {r['value']:>8.2f}% {tgt:>9}  {mark:5}  {r['metric']}")
        if r["detail"]:
            print(f"{'':31}{r['detail']}")
    if args.json:
        with open(args.json, "w", encoding="utf-8") as f:
            json.dump(results, f, indent=2, ensure_ascii=False)


if __name__ == "__main__":
    main()
