#!/usr/bin/env python3
import os
import sys
import ibus
import signal

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from xrnikey_engine import main as engine_main

def run():
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    component = engine_main()
    engine = ibus.get_engine_factory(component)
    ibus.main(engine)

if __name__ == "__main__":
    run()
